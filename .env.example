# Transport Management System — environment template
# Copy to .env and fill in values.

# --- Database ------------------------------------------------------------
# PostgreSQL connection string. (SQLite `file:./dev.db` is also supported —
# just set the provider in prisma/schema.prisma accordingly.)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tms"

# --- Auth ----------------------------------------------------------------
# Long random string used to sign session JWTs. REQUIRED in production.
AUTH_SECRET="change-me-to-a-long-random-string"
SESSION_MAX_AGE_SECONDS=2592000

# Business timezone for all date display + grouping (default Asia/Dhaka)
NEXT_PUBLIC_APP_TIMEZONE="Asia/Dhaka"

# Public URL used in emailed password-reset links (no trailing slash)
APP_URL="http://localhost:3000"

# --- Optional -------------------------------------------------------------
# Default admin account created by the seed script (dev only).
SEED_ADMIN_EMAIL="admin@tms.local"
SEED_ADMIN_PASSWORD=change-me-in-your-own-.env

# --- Email notifications (optional) ---------------------------------------
# Leave unset to disable email (in-app notifications still work).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="you@example.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="TMS <you@example.com>"
